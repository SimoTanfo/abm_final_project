# Copia questo file in .env.local per lo sviluppo locale.
# Su Vercel inserisci gli stessi nomi in Settings > Environment Variables.

# Password per entrare in /admin. Usane una lunga.
ADMIN_PASSWORD=

# Segreto per firmare inviti e sessione admin, almeno 32 caratteri.
# Generalo con: openssl rand -base64 48
INVITE_SECRET=

# Dal file JSON del service account: campo "client_email"
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Dal file JSON del service account: campo "private_key".
# Va bene sia con i \n letterali (come nel JSON) sia con gli a capo veri.
GOOGLE_PRIVATE_KEY=

# L'ID del calendario: per il calendario principale è il tuo indirizzo Gmail
GOOGLE_CALENDAR_ID=

# Solo in locale: 1 = calendario finto in memoria, senza Google. Ignorato in produzione su Vercel.
# CALENDAR_MOCK=1
